# /etc/cloudstore.env — every setting in server/cloudstore/config.py can be set here.

# System SSD: metadata DB, tus staging, thumbnails, Bloom filter. Originals never live here.
CLOUDSTORE_DATA_DIR=/var/lib/cloudstore
CLOUDSTORE_WEB_DIST=/opt/cloudstore/src/web/dist

# Erasure coding: 4 data + 2 parity across 6 disks (survives any 2 failures, 67% usable).
# With fewer than 6 disks registered the store runs in mirror mode automatically.
CLOUDSTORE_EC_K=4
CLOUDSTORE_EC_M=2
CLOUDSTORE_MAX_SHARD_SIZE=4194304

# Background integrity work (bytes/second) — keeps foreground reads responsive.
CLOUDSTORE_SCRUB_RATE_BYTES=52428800
CLOUDSTORE_SCRUB_INTERVAL_DAYS=30
CLOUDSTORE_REBUILD_RATE_BYTES=157286400

# Non-media tier: seal a batch at 1 GiB or after 6 hours, whichever first.
CLOUDSTORE_BATCH_THRESHOLD=1073741824
CLOUDSTORE_BATCH_MAX_AGE_S=21600

# Served over HTTPS by `tailscale serve`, so cookies can be Secure.
CLOUDSTORE_COOKIE_SECURE=true

# Near-duplicate radius (Hamming distance on 64-bit pHash); index: mih | bktree
CLOUDSTORE_DUP_RADIUS=10
CLOUDSTORE_DUP_INDEX=mih
